0244    	  IF NOT B1		% NO ERROR
0244    	  THEN GETNEXT;		% SO SCAN THE TOKEN!
0252    	  IF B		% NOT TOG
0252    	  THEN BEGIN	% RESET	THE TEMPORARY DECLARATION
0260 3  	    DO PERMDEC[I]:=REAL(NOT BOOLEAN(PERMDEC[I]))
0265    	    UNTIL I+1 EQL 8
