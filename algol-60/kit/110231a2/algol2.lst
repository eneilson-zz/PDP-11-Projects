0164    	  ELSE COMPOUNDTAIL;
0173    23-34:	  FLAG(56); DECLARATION; GO AGAIN;
0206    35-36:	  WRITESTMT;
0213    37:	  FORSTMT;
0220    38:	  WHILESTMT;
0225    39:	  DOSTMT;
0232    40:	  IFSTMT;
0237    41:	  GOSTMT; GO EXIT;
0246    42:	  FILLSTMT;
0253    43:	  CASESTMT;
0260    44:	  REPLACESTMT;
