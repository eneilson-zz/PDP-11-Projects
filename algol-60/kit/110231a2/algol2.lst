1306    		A UNTIL EQL 0, 0 FOR 1;
1324    	  REPLACE CODE.TITLE BY	POINTER(STR);
1342    	  NOCODEFILE:=FALSE	% ASSIGN TO NOCODEFILE IN CASE 2ND TIME	AROUND
1343    	  END
1345 2  	ELSE NOCODEFILE:=NOT COMPILEANDGO:=FALSE;
