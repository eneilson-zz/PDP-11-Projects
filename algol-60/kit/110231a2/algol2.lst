0010    	  IF B:=CLASS EQL STRINGID AND REAL(P,1) EQL ":"
0020    	  THEN BEGIN	% COULD	BE UPDATE OR ASSIGNMENT
0026 3  	    T:=INFO;	% SAVE FOR ADDRESS LATER ON
0031    	    GETNEXT;	% SEE WHAT IT WAS
