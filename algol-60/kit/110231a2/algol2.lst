0171    		END;
0173 5  	      GETNEXT		% SCAN THE THING
0174    	      END;
0176 4  	    AEXP;		% GET MAXLENGTH
0201    	    IF B AND NOT IUPDATE	% THING
0202    	    THEN BEGIN			% WAS
0207 4  	      IF ID			% ONLY
0207    	      THEN EMITPROCAORV(T,TRUE)	% AN
0215    	      ELSE EMITADDRESS(T,0);	% ASSIGNMENT
0226    	      EMIT(STN)			% SAVE VALUE
0230    	      END
0232 4  	    END;
