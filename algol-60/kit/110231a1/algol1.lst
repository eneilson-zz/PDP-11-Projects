0000    	    GETNEXT;		% SCAN THE 'CASE'
0005    	    TL:=BUMPL;		% LEAVE	ROOM FOR THE STACK BUILDING CODE
0014    	    AEXP;		% GET CASE INDEX
0017    	    EMIT(OCX);		% DO OCCURS INDEX INTO CASE BODY
0023    	    EL:=L;		% WHERE	1ST INDICIE IS AT
0026    	    IF CLASS NEQ OFV	% MISSING 'OF'
0027    	    THEN BEGIN
0033 4  	      FLAG(97);		% TELL HIM
