0056    	    IF CLASS NEQ LFTPAREN	% MISSING '('
0057    	    THEN BEGIN
0063 4  	      FLAG(31);		% TELL HIM
0067    	      GO EXIT
0103    	      END;
0103 4  	    IF X GEQ 0		% IF NOT DESIGNATIONAL EXPRESSION
0106    	    THEN GETNEXT;	% ELSE GOSTMT WILL SCAN	IT
