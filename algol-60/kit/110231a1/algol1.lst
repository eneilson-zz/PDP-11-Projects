0475    SAVE PROCEDURE GETNEXT;
   000726-P = GETNEXT
0475    	BEGIN
0475 2  	INTEGER	I,X,T,S,PNO;
                                                 GETNEXT IS SEGMENT 015 ********
   030005-S = I
