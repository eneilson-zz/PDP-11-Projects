	IT WAS NECESSARY TO REDUCE THE SIZE OF THE LISTING FILE TO MAKE IT
	FIT ON A SINGLE DEC-TAPE. THIS WAS ONE OF THE PAGES THAT
	VOLUNTEERED TO GO.
PDP-11 ALGOL COMPILER, VERSION 6.6.019                     3/5/76        PAGE 78


0733    	      EMIT(FONES);
0737    	12:				% COMPILETIME
0741    	      IF CLASS NEQ ICONSTANT OR	INREAL LSS 0 OR	INREAL GTR 5
0752    	      THEN FLAG(38)
0760    	      ELSE BEGIN
0764 4  		EMITL(TIME(INREAL));
0772    		GETNEXT
0773    		END
0775 4  	    END	OF CASES;
1014 3  	  CHECKIT(RTPAREN,32)		% ')' SHOULD FOLLOW INTRINSICS
1030    	  END;
