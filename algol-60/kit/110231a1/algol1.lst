0017    	  THEN BEGIN		% LETTUCE PARCELY IT
0023 3  	    GETNEXT;		% SCAN THE 'IF'
0026    	    BEXP;		% BOOLEAN EXPRESSION
0031    	    IF CLASS NEQ THENV	% FOLLOWED BY A	'THEN'?
0032    	    THEN BEGIN
0036 4  	      FLAG(39);		% 'THEN' EXPECTED
0042    	      GO EXIT
0045    	      END;
