0001    INTEGER	ARRAY
0001    	A[0:32],	% HOLDS	THE LAST SCANNED IDENTIFIER IN SYMBOL
   000213-P = A
0010    			% TABLE	FORMAT - THIS IS USED TO SPEED UP
