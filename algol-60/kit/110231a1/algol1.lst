   030006-S = I
0003    	  IF X LEQ 3		% ALREADY KNOW WHAT TO DO
0010    	  THEN
0013    	    CASE X+1 OF
0021    	    BEGIN
0022 3  	      BEGIN		% DESIGNATIONAL	EXPRESSION
0022 4  		ACTIONTOG:=TRUE;
0025    		GOSTMT
0026    		END;
0030 4  	      BEGIN		% STRING EXPRESSION
0032 4  		IF CLASS EQL CASEV OR CLASS EQL IFV
