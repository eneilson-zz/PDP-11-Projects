0513 2  BOOLEAN	PROCEDURE EACHCASE(X);
   001127-P = EACHCASE
0513    %	X =-1	    DESIGNATIONAL EXPRESSION (GO TO)
0513    %	    0	    QUOTED STRING EXPRESSION
0513    %	    1	    ARITHMETIC EXPRESSION
0513    %	    2	    POINTER EXPRESSION
0513    %	    3	    BOOLEAN EXPRESSION
0513    %	    4	    POINTER, STRING, OR	ARITHMETIC (REPLACE STMT)
0513    %	    5	    POINTER OR ARITHMETIC	   (PRIMARY - REAL FUNCTION)
0513    %	    6	    POINTER,ARITHMETIC OR BOOLEAN  (BOOPRIM - BOOLEAN())
0513    %	    7	    POINTER OR QUOTED STRING	   (BOOPTRPRIM)
0513    	INTEGER	X;
0513    	BEGIN
0513 2  	  LABEL	L1,L2;
                                                EACHCASE IS SEGMENT 057 ********
0001    	  BOOLEAN B;
   030005-S = B
