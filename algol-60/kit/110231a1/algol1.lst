                                              WRITEALINE IS SEGMENT 002 ********
   030005-S = I
0002    	  LABEL	EXIT;
0002    	  IF EOPTION OR	NOLISTFILE
0005    	  THEN GO EXIT;
0013    	  IF NOT LNCT =	100
0015    	  THEN WRITE(LINE,X,LINEOUT);
0033    	  IF LNCT:=LNCT + 1 GTR 56
0041    	  THEN BEGIN
0044 3  	    LINEOUT[0]:=3"14";
0050    	    WRITE(LINE[0],1,LINEOUT);
0062    	    REPLACE LINEOUT BY HEADING FOR 38," " FOR 20, DATE FOR 8,
0103    		" " FOR 8-(I:=REAL(PGCT:=*+1 GTR 9)+REAL(PGCT GTR 99)),
0126    		"PAGE",ZS(PGCT,I+2);
0142    	    WRITE(LINE,40,LINEOUT);
0155    	    WRITE(LINE[1],LNCT:=REAL(WRITEAFORM:=FALSE),LINEOUT)
0167    	    END;
0173 3  EXIT:	END;
