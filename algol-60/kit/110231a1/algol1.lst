0120 4  	      CASES[CC:=CC+1]:=L;% SAVE	START OF EACH EXPRESSION
0130    	      IF EACHCASE(X)	% SEE IF A VALID CASE
0133    	      THEN GO EXIT;	% NO
0153    	      CASES[CC:=CC+1]:=BUMPL;	% WHERE	TO LEAVE FROM
0167    	      CONSTANTCLEAN;	% DUMP FLOATING	POOL ARRAYS
0177    	      IF CLASS EQL COMMA OR N:=CLASS EQL RTPAREN
