   000205-P = STARTDEFINE
0001    	SWITCHDECTOG,	% SET TO TRUE WHEN IN SWITCHDEC, FALSE OTHERWISE
   000206-P = SWITCHDECTOG
0001    	TOBEWRITTEN,	% SET TO TRUE WHEN WE ARE TO WRITE OUT THE NEXT
