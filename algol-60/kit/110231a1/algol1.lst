   000207-P = TOBEWRITTEN
0001    	UIC,		% USED TO DETERMINE IF A FILE HAS A UICOR SIZE OPTION
   000210-P = UIC
0001    	WRITEAFORM;	% USED TO PRINT	FORMS FROM INPUT IN NICE PLACES
