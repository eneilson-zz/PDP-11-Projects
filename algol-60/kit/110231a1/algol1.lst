0001    			% USED TO SPEED UP 'PURGEIT'
   000135-P = SYMBOLTABLESIZE
0001    	TIME1,		% TIME IN MINUTES (CLOCK TIME) AT THE
0001    			% START	OF COMPILATION
   000136-P = TIME1
0001    	TOTSEG,		% TOTAL	AMOUNT OF OBJECT CODE PRODUCED
0001    			% BY THE COMPILER
   000137-P = TOTSEG
