% PRIME NUMBERS BELOW 100, TEN TO A LINE, BY TRIAL DIVISION.
BEGIN
  DEFINE ZS(I,J) = I FOR J ZEROSUPPRESSED DIGITS#;
  FILE TT(KIND=REMOTE,MYUSE=3"400");
  ARRAY BUF[0:39];
  POINTER P;
  INTEGER N,D,COL,COUNT;
  BOOLEAN PRIME;
  FOR N:=2 STEP 1 UNTIL 99 DO
  BEGIN
    PRIME:=TRUE;
    D:=2;
    WHILE D*D LEQ N AND PRIME DO
    BEGIN
      IF N MOD D = 0 THEN PRIME:=FALSE;
      D:=D+1
    END;
    IF PRIME THEN
    BEGIN
      IF COL = 0 THEN P:=BUF;
      REPLACE P:P BY ZS(N,4);
      COUNT:=COUNT+1;
      COL:=COL+1;
      IF COL = 10 THEN
      BEGIN
        WRITE(TT,40,BUF);
        COL:=0
      END
    END
  END;
  IF COL > 0 THEN WRITE(TT,COL*4,BUF);
  REPLACE BUF BY ZS(COUNT,2)," PRIMES BELOW 100";
  WRITE(TT,19,BUF)
END.
