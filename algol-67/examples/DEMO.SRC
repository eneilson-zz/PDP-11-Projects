%	BASE CHANGE DEMO PROGRAM.
%
%	DEMOS MOST OF ALGOLS FEATURES.
BEGIN

  DEFINE ZS(I,J) = I FOR J ZEROSUPPRESSED DIGITS#;
  FILE TT(KIND=REMOTE,MYUSE=3"400");	% HIGH BYTE OF MYUSE SET TO NO-ZERO
					% FOR UNITS = CHARACTERS.
  ARRAY BUFFER,BUFOUT[0:39],BASECHARS[0:7],TEMP[0:8];
  TRUTHSET POSSIBLECHOICES("0123456789ABCDEF");
  POINTER P,Q,R,BP;
  INTEGER BASEIN,BASEOUT,NUMLEN,NUM,T;
	% I KNOW LABELS AREN'T VERY STRUCTURED LOOKING BUT...
  LABEL AGAIN,START,EXIT,DEBLANK;

PROCEDURE CONVERT(P,I);
	VALUE I;
	INTEGER I;
	POINTER P;
	BEGIN
	  IF I GEQ BASEOUT
	  THEN CONVERT(P,I DIV BASEOUT);% NOTHING LIKE A LITTLE RECURSION.
	  % THE FOLLOWING IS THE REASON FOR THE LIMIT ON THE OUTPUT BASE.
	  REPLACE P:P BY I MOD BASEOUT FOR 1 HEX DIGIT;
	  END;

  REPLACE BASECHARS BY "0123456789ABCDEF";
  REPLACE BUFFER BY " " FOR 13,"BASE CHANGE DEMO PROGRAM";
  WRITE(TT[1],0,BUFFER);
  WRITE(TT,37,BUFFER);		% WRITE OUT HEADER.
  REPLACE BUFFER BY " " FOR 5,
	  "CONVERTS NUMBERS FROM ONE BASE TO ANOTHER";
  WRITE(TT,46,BUFFER);
  WRITE(TT,0,BUFFER);
START:
  REPLACE BUFFER BY "BASES MUST BE BETWEEN 2 AND 16 (INCLUSIVE)";
  WRITE(TT,42,BUFFER);
  DO BEGIN
AGAIN:	REPLACE BUFFER BY "ENTER #, INPUT BASE, OUTPUT BASE -- ";
	WRITE(TT[0],36,BUFFER);
	READ(TT,30,BUFFER)[EXIT];	% EOF TRANSFER TO EXIT.
	BUFFER[15]:=0;			% TO STOP A SCAN.
	SCAN P:BUFFER WHILE EQL " ";	% DO SOME DEBLANKING.
	REPLACE BP:BUFOUT BY Q:P WHILE IN POSSIBLECHOICES,
		" IN BASE ";
	IF NUMLEN:=DELTA(P,Q) EQL 0
	THEN GO AGAIN;			% DIDNT GET ANYTHING.
	SCAN Q:Q WHILE EQL " ";
	IF Q NEQ ","
	THEN GO AGAIN;			% MISSING COMMA.
	SCAN Q:Q+1 WHILE EQL " ";	% DEBLANK THE INPUT BASE.
	REPLACE BP:BP BY R:Q WHILE IN NUMERIC,	% GET LENGTH OF BASE IN.
		" IS ";
	IF BASEIN:=INTEGER(Q,DELTA(Q,R)) LSS 2	% GET THE INPUT BASE.
		OR BASEIN GTR 16
	THEN GO START;			% INVALID INPUT BASE.
	SCAN Q:R WHILE EQL " ";
	IF Q NEQ ","
	THEN GO AGAIN;			% MISSING COMMA.
	SCAN Q:Q+1 WHILE EQL " ";	% DEBLANK THE OUTPUT BASE.
	SCAN R:Q WHILE IN NUMERIC;	% FIGURE ITS LENGTH.
	IF BASEOUT:=INTEGER(Q,DELTA(Q,R)) LSS 2
		OR BASEOUT GTR 16	% IS IT VALID?
	THEN GO START;			% APPARANTLY NOT.
	SCAN R:R WHILE EQL " ";
	IF REAL(R,1) NEQ 0
	THEN BEGIN
	  REPLACE BUFFER BY "GARBAGE AT END OF LINE.";
	  WRITE(TT,23,BUFFER);
	  GO AGAIN
	  END;

	NUM:=0;		% RE-INITIALIZE THE # TO 0 (IN CASE NOT 1ST TIME).
	% NOW TO INPUT THE NUMBER TO CONVERT.
	THRU NUMLEN
	DO BEGIN		% LOOK AT EACH INPUT CHAR TO DETERMINE
				% ITS VALIDITY.
	  SCAN BASECHARS FOR T:16 UNTIL EQL REAL(P,1);
	  IF T:=16-T GEQ BASEIN	% WELL IS IT?
	  THEN BEGIN		% NOPE.
	    REPLACE BUFFER BY P FOR 1, " NOT IN BASE.";
	    WRITE(TT,14,BUFFER);
	    GO AGAIN;
	    END;
	  NUM:=* * BASEIN + T;
	  P:=*+1
	  END;

	% NOW TO CONVERT TO OUTPUT BASE.
	REPLACE P:=TEMP BY 0 FOR 9 WORDS;
	CASE BASEOUT OF
	BEGIN
2:	  REPLACE P BY NUM FOR 16 ZEROSUPPRESSED BINARY DIGITS;
	  GO DEBLANK;
3-7:
9:
11-15:	  CONVERT(P,NUM);
	  P:=TEMP;
8:	  REPLACE P BY NUM FOR 6 ZEROSUPPRESSED OCTAL DIGITS;
	  GO DEBLANK;
10:	  REPLACE P BY ZS(NUM,5);
	  GO DEBLANK;
16:	  REPLACE P BY NUM FOR 4 ZEROSUPPRESSED HEX DIGITS;
DEBLANK:  SCAN P:P WHILE EQL " ";
	  END OF CASE;

	% NOW TO PRINT IT OUT.
	REPLACE BP:BP BY P UNTIL EQL 0," IN BASE ",Q WHILE IN NUMERIC;
	WRITE(TT,DELTA(BUFOUT,BP),BUFOUT);
	END
  UNTIL FALSE;		% CONVERT FOR AS LONG AS YOU LIKE!
EXIT:
END.
