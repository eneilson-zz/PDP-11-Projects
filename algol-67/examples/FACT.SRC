% FACTORIALS BY RECURSION.
BEGIN
  DEFINE ZS(I,J) = I FOR J ZEROSUPPRESSED DIGITS#;
  FILE TT(KIND=REMOTE,MYUSE=3"400");
  ARRAY BUF[0:39];
  INTEGER N;
  INTEGER PROCEDURE FACT(N);
    VALUE N;
    INTEGER N;
    FACT:=IF N LEQ 1 THEN 1 ELSE N*FACT(N-1);
  FOR N:=1 STEP 1 UNTIL 7 DO
  BEGIN
    REPLACE BUF BY "FACTORIAL OF ",ZS(N,2)," IS ",ZS(FACT(N),5);
    WRITE(TT,24,BUF)
  END
END.
