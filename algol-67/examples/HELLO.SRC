% HELLO WORLD, WITH A LOOP.  COUNTS ARE IN CHARACTERS (TT IS OPENED IN CHARACTER MODE).
BEGIN
  DEFINE ZS(I,J) = I FOR J ZEROSUPPRESSED DIGITS#;
  FILE TT(KIND=REMOTE,MYUSE=3"400");
  ARRAY BUF[0:39];
  INTEGER I;
  REPLACE BUF BY "HELLO, WORLD";
  WRITE(TT,12,BUF);
  FOR I:=1 STEP 1 UNTIL 3 DO
  BEGIN
    REPLACE BUF BY "LINE ",ZS(I,1);
    WRITE(TT,6,BUF)
  END
END.
