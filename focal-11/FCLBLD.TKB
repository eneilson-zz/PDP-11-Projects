;RSX FOCAL TASKBUILD FILE, NO INTERRUPT VERSION.
FCL/FP/CP/MU=FCLMAI,FCLINI
/
TASK=...FCL
STACK=4000
PRI=50
UNITS=30
ASG=TI:22:23
ASG=TI:26
; UN COMMENT NEXT LINE IF YOU HAVE RSX11M+ AND SUPER MODE
;SUPLIB=FCSFSL:SV
;FOLLOWING LINE ALLOWS ALARMS EVEN THOUGH NO EXTERNAL PAGE USED
GBLDEF=PSWEXT:240
;CHANGE PSWEXT TO FOLLOWING FOR REAL INTERRUPTS
;GBLDEF=PSWEXT:177776
GBLDEF=KPAR0:172340
GBLDEF=KPDR0:172300
GBLDEF=SPAR0:172240
GBLDEF=SPDR0:172200
GBLDEF=SPDR6:172214
GBLDEF=SPDR7:172216
GBLDEF=SPAR6:172254
GBLDEF=SPAR7:172256
GBLDEF=UPAR0:177640
;MEMORY MANAGEMENT REGISTERS
;COMMON=EXTCOM:RW
ASG=TI:27
ASG=TI:1:2:3:4
ASG=TI:5:6:7
ASG=TI:10:11:12:13:14:15
ASG=TI:16:17:20
//
