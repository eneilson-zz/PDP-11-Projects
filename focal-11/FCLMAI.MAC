INDEV:	PRS		;POINTER TO IN. DEV STATUS
OUTDEV:	TPS		;POINTER TO OUT. DEV STATUS. = (END SAVE AREA)
KIN:	0		;(INTR DONE,TTY CHARACTER)
WHOOPS:	000		;POWER FAIL/AUTO-RESTART SWITCH
AXIN:	BUFBEG+200.	;STORAGE INDEX POINTER (STOPS 1ST "ERASEV"!)
BUFR:	BUFBEG		;NEXT LOCATION IN BUFFER = LAST LOCATION USED.
STARTV:	BUFBEG+200.	;BEGINNING OF BUFFER AREA
TOP:	BUFBEG		;BEGINNING OF TEXT BUFFER AREA.
BOTTOM:	17500		;END OF ALL CORE (REALLY A CONSTANT)
			;CONTINUED
BOTVEC:	.WORD	17500	;LOWEST ADDRESS OF VECTORS (=BOTTOM AT START AND
			;AFTER AN 'ERASEV'.
OUTADX:	.WORD	0	;IF NON-0, PUT PRINTED CHARACTERS HERE

	.EVEN
	.PSECT	DATA,RW
	.EVEN
CFRS:	-2		;TEXT DATA POINTER
	000		;LINE ZERO.
.ASCII "C:RSX FOCAL-11 V11-01C ";VERSION ID
.BYTE	216
.EVEN

