ATLIST=.		;*ASK*TYPE* CONTROL CHARACTER TABLE
	TINTR		;%-FORMAT DELIMITER
	TQUOT		;"-LITERAL DELIMITER
	TCRLF		;!-CARRIAGE RETURN AND LINE FEED
	TCRLF2		;#-CARRIAGE RETURN ONLY
