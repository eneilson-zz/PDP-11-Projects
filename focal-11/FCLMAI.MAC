	USING		;USING	 ;U-	    ;W-		;P-
	.IFF
	ERRORC
	.ENDC
	VARALO		;VECTOR	 ;W-	    ;Q-		;V-
	WRITE		;WRITE	 ;INSCRIS   ;ESCRIBA	;TIPPE
	XECUTE		;XECUTE	 ;XECUTE    ;FLUIR	;XECUTE
